# Copy to .env locally. No paid service credentials are needed for this scaffold.
LATHER_ENVIRONMENT=local
LATHER_CHAOS_ENABLED=false
LATHER_EVALUATIONS_ENABLED=false
# Explicit authenticated human-role grants, JSON UUID arrays; empty denies review writes.
LATHER_TRUSTED_REVIEWER_IDS=[]
LATHER_BUSINESS_OWNER_IDS=[]
# Remote trace export is separate from app tracing and disabled until explicitly approved.
LATHER_TRACE_ENABLED=false
LATHER_TRACE_EXPORT_APPROVED=false
LATHER_TRACE_MAX_RUNS=0
# LATHER_TRACE_API_KEY=
# LATHER_TRACE_EXISTING_PROJECT_ID=
# Chaos requires environment=test, this explicit flag=true and the dedicated local DB.
# Production refuses the flag; no live provider or external action is enabled.
LATHER_MODE=replay
LATHER_EXTERNAL_CALLS_ENABLED=false
LATHER_LANGSMITH_ENABLED=false
# Runtime login must be NOSUPERUSER NOBYPASSRLS and a member of lather_api.
# Use scripts/local-auth.ps1 for local test credentials; never paste secrets here.
# LATHER_DATABASE_URL=
# LATHER_SUPABASE_URL=http://127.0.0.1:57421
# LATHER_SUPABASE_PUBLISHABLE_KEY=
# Migration/admin credentials are separate and never sent to frontend.
# For frontend configuration, copy frontend/.env.example to frontend/.env.local.
# Its private LATHER_API_BASE_URL is used by same-origin server routes.
NEXT_TELEMETRY_DISABLED=1
# Optional explicitly authorized local pilot only. Never use NEXT_PUBLIC keys.
# These secrets alone do not authorize a run; a scoped local permit is required.
# LATHER_TAVILY_API_KEY=
# LATHER_LLM_API_KEY=
